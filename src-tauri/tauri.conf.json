{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "height": 800,
        "minHeight": 600,
        "minWidth": 800,
        "title": "Harbor",
        "width": 1200
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "pnpm run build",
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  },
  "identifier": "io.harbor.desktop",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "harbor"
        ]
      },
      "mobile": []
    },
    "updater": {
      "endpoints": [
        "https://github.com/bakobiibizo/harbor/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0QkFDOTAwMkUzQzIyODkKUldTSklqd3VBTW02RkdtNFhYeTd5USs1SWR0VWxHRzA4K3ZwaGdRQ2lXWXk5YTZUaUhvQzZxeU0K"
    }
  },
  "productName": "Harbor",
  "version": "1.4.1-beta.3"
}
